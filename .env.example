# ==============================================================================
# COGNITO - ENVIRONMENT CONFIGURATION (LİSE AKADEMİK PROGRAMI)
# ==============================================================================

# Supabase Project Credentials
# Retrieve these from your Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here

# Note:
# When these keys are left blank or omitted, Cognito seamlessly operates
# in offline/mock simulation mode with an authentic Google Account Selection modal,
# so local testing and review work 100% out of the box without crashing!
